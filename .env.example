# Optional. Defaults to ignored .data/revision-club.db, copied once from posts.db.
# DATABASE_PATH=/absolute/path/to/revision-club.db
# Required for AI generation and semantic marking. Never expose as NEXT_PUBLIC.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional free fallback for text, documents and supported images.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openrouter/free
# Optional trusted origin for explicit same-origin enforcement.
# APP_ORIGIN=http://localhost:3000
