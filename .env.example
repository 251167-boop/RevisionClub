# Optional. Defaults to ignored .data/revision-club.db, copied once from posts.db.
# DATABASE_PATH=/absolute/path/to/revision-club.db

# Production MySQL database. Keep the password server-side and out of Git.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_SSL=true
MYSQL_SSL_REJECT_UNAUTHORIZED=true

# Google OAuth. Add this callback URL in Google Cloud:
# https://your-domain.example/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Password reset email delivery through Resend.
RESEND_API_KEY=
EMAIL_FROM=Revision Club <noreply@your-domain.example>
# Required for AI generation and semantic marking. Never expose as NEXT_PUBLIC.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional override for generated question illustrations.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Optional free fallback for text, documents and supported images.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openrouter/free
# Comma-separated free vision models used to extract uploaded PDFs and images.
OPENROUTER_VISION_MODELS=dots-studio/dots-3-note-preview:free,google/gemma-4-26b-a4b-it:free
# Optional trusted origin for explicit same-origin enforcement.
# APP_ORIGIN=http://localhost:3000
